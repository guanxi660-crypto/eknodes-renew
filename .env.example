# ===== 必填 =====
# EkNodes 登录邮箱与密码
EK_EMAIL=你的登录邮箱
EK_PASSWORD=你的登录密码

# ===== 可选 =====
# Telegram 通知（chat_id,bot_token，逗号分隔）
# TG_BOT=123456789,123456:ABC-DEF...

# 续期触发阈值：距到期不足多少小时才续期（默认 48，一般不用改）
# EK_RENEW_THRESHOLD_HOURS=48

# 出口代理（SOCKS5），GitHub Actions 里配合 VLESS_NODE 自动注入，本地可留空
# PROXY_URL=socks5://127.0.0.1:10808
